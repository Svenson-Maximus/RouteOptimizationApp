@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

Person(staff, "Bakery Staff")
Person(planner, "Planner")
System_Ext(google, "Google Maps APIs")

System_Boundary(fp2, "Focus Project 2") {
  Container(ui, "Address Validation UI", "React", "Address cleanup, run trigger, run inspection")
  Container(di, "Data Integration Service", "Spring Boot", "Excel import and mapping")
  Container(cm, "Customer Master Service", "Spring Boot", "Customer/address lifecycle")
  Container(geo, "Geocoding Service", "Spring Boot", "Geocoding and coordinate storage")
  Container(orchestrator, "Optimization Orchestrator", "Spring Boot", "Optimization run control")
  Container(opt, "Route Optimization Engine", "Python + OR-Tools", "CVRPTW solver")
  ContainerDb(db, "PostgreSQL", "RDBMS", "Customers, addresses, imports, geocodes, runs")
}

Rel(staff, ui, "Uses")
Rel(planner, ui, "Uses")
Rel(ui, cm, "Reads/updates")
Rel(ui, geo, "Triggers geocoding")
Rel(ui, orchestrator, "Starts/inspects runs")
Rel(di, cm, "Creates/updates records")
Rel(geo, google, "Calls")
Rel(orchestrator, opt, "Runs optimization")
Rel(cm, db, "Reads/writes")
Rel(di, db, "Reads/writes")
Rel(geo, db, "Reads/writes")
Rel(orchestrator, db, "Reads/writes")
Rel(opt, db, "Reads/writes (optional)")

@enduml
