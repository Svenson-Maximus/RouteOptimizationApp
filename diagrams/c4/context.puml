@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

Person(staff, "Bakery Staff", "Validates and corrects customer addresses")
Person(planner, "Planner", "Runs and inspects route optimization")
System(fp2, "Focus Project 2 Platform", "Import, validate, geocode, and optimize deliveries")
System_Ext(google, "Google Maps APIs", "Geocoding and place data")
System_Ext(aws, "AWS", "Cloud runtime services")

Rel(staff, fp2, "Uses")
Rel(planner, fp2, "Uses")
Rel(fp2, google, "Geocodes addresses")
Rel(fp2, aws, "Runs on")

@enduml
