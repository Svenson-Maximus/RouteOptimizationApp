@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

Container_Boundary(di, "Data Integration Service") {
  Component(upload, "Upload Controller", "Spring Web", "Receives Excel upload")
  Component(parser, "Excel Parser", "Service", "Parses rows and columns")
  Component(mapper, "Mapping/Validation", "Service", "Maps rows into domain objects")
  Component(job, "Import Job Tracker", "Service", "Tracks job/row status")
  Component(repo, "Persistence Adapter", "Repository", "Writes data to PostgreSQL")
}

Rel(upload, parser, "Invokes")
Rel(parser, mapper, "Passes parsed rows")
Rel(mapper, job, "Reports row status")
Rel(mapper, repo, "Persists mapped entities")

@enduml
